# Google Places / Geocoding API key (https://console.cloud.google.com/apis/credentials)
GOOGLE_PLACES_API_KEY=

# Optional: Claude API key para generar mensajes con IA (si se deja vacio se usan plantillas)
ANTHROPIC_API_KEY=

# Optional: Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Base de datos (SQLite local por defecto)
DATABASE_URL=sqlite:///./leadfinder.db

# Clave para crear clientes nuevos via POST /api/admin/clients (X-Admin-Key)
ADMIN_KEY=
